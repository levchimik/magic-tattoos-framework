# Editor / backup / scratch
*.bak
*.bak-*
*.bak.*
*.bak2
*.broken-stub.bak
*.tmp
*.log

# Build outputs
source/scripts/*.pex
_build/
_deps/

# Binary ESPs — version-controlled via Spriggit YAML mirrors under spriggit/
# instead. Rebuild local copies with: bash tools/build_esps.sh
# The deserialize step writes into _build/esps/; the FOMOD build consumes
# them from there. Keeps history clean and diffs human-readable.
*.esp
*.esm
*.esl

# C++ SKSE plugin build artifacts (also covered by cpp-plugin/.gitignore)
cpp-plugin/build/
cpp-plugin/vcpkg_installed/
cpp-plugin/extern/
cpp-plugin/_skee_ref/

# Local recovery snapshots (created ad-hoc before destructive git ops)
.git-backup-*/

# Tattoo design vision-reference renders (large, regeneratable from textures)
docs/visual-refs/

# Content-pack adapters held locally for personal use only (author permission
# pending — adapter is not redistributed via this repo or the FOMOD).
content-packs/obi-tattoos/

# Internal-only docs (roadmaps, idea logs, draft Nexus copy, dev playbooks).
# Kept locally for reference but not part of the public mod surface.
docs/internal/

# Local scratch dumps & perf/research notes (ad-hoc, not part of the mod).
_research/
_acts.txt
_ml.txt

# Python bytecode cache
tools/__pycache__/
__pycache__/
*.pyc
