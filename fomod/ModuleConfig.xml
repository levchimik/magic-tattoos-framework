<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>LewdMarks Effects</moduleName>
  <installSteps order="Explicit">
    <installStep name="Select Skyrim version">
      <optionalFileGroups order="Explicit">
        <group name="Select Skyrim version" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Skyrim SE/AE">
              <description>Install for Skyrim Special Edition / Anniversary Edition</description>
              <files>
                <file source="LewdMarksEffects.esp" destination="LewdMarksEffects.esp"/>
                <folder source="scripts" destination="scripts"/>
                <folder source="source" destination="source"/>
              </files>
              <typeDescriptor>
                <type name="Optional"/>
              </typeDescriptor>
            </plugin>
            <plugin name="Skyrim LE">
              <description>Install for Skyrim Legendary Edition</description>
              <files>
                <file source="LewdMarksEffects.esp" destination="LewdMarksEffects.esp"/>
                <folder source="scripts" destination="scripts"/>
                <folder source="source\scripts" destination="scripts\source"/>
              </files>
              <typeDescriptor>
                <type name="Optional"/>
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
