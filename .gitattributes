# Default: normalize line endings on commit, LF on checkout.
* text=auto eol=lf

# Source files — always LF
*.psc      text eol=lf
*.cpp      text eol=lf
*.h        text eol=lf
*.hpp      text eol=lf
*.lua      text eol=lf
*.sh       text eol=lf
*.py       text eol=lf
*.js       text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.ini      text eol=lf
*.toml     text eol=lf
*.xml      text eol=lf
*.cmake    text eol=lf
CMakeLists.txt text eol=lf

# Windows shell scripts — must keep CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Skyrim / Bethesda binaries — never diff/merge as text
*.esp      binary
*.esm      binary
*.esl      binary
*.bsa      binary
*.ba2      binary
*.pex      binary
*.nif      binary
*.tri      binary
*.hkx      binary
*.dds      binary
*.tga      binary
*.fuz      binary
*.xwm      binary
*.wav      binary
*.lip      binary
*.sav      binary

# Common binary asset / archive formats
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.7z       binary
*.zip      binary
*.rar      binary
*.dll      binary
*.exe      binary
*.lib      binary
*.pdb      binary

# GitHub linguist hints
*.psc      linguist-language=Papyrus
*.pex      linguist-detectable=false
